# ==============================================================================
# Astroveda + JAPAM Spiritual Platform: Master Environment Variables Template
# Copy this file to .env and populate with deployment-specific parameters.
# NEVER commit production secrets, database credentials, or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Astroveda Next.js 16 Storefront)
# ------------------------------------------------------------------------------
# Public REST API Base URL (Must be accessible from the customer's browser)
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (JAPAM Flask API & Admin Panel)
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Cryptographic Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_64_character_hex_key
JWT_SECRET_KEY=change_this_to_another_random_64_character_hex_key

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://japam_user:ChangeThisPostgresPassword@postgres:5432/japam_db

# Redis Cache & Background Tasks
REDIS_URL=redis://redis:6379/0

# Strict CORS Allowlist (Comma-separated origins, no trailing slashes)
CORS_ORIGINS=https://store.yourdomain.com,https://yourdomain.com

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

# ------------------------------------------------------------------------------
# DATABASE & INFRASTRUCTURE CONTAINERS
# ------------------------------------------------------------------------------
POSTGRES_USER=japam_user
POSTGRES_PASSWORD=ChangeThisPostgresPassword
POSTGRES_DB=japam_db
